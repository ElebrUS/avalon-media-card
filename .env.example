# TMDB API Read Access Token (v4 auth)
TMDB_READ_TOKEN=your_tmdb_read_access_token_here

# Trakt.tv Integration Settings
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here
TRAKT_ACCESS_TOKEN=your_trakt_access_token_here
TRAKT_REDIRECT_URI=http://localhost:8081

# Lampac Gateway Adapter (lampac-adapter-plugin)
# Base URL of your Lampac instance
LAMPAC_HOST=http://127.0.0.1:9118
# Accsdb identity — set at least one when Lampac has accsdb.enable=true
# Prefer a dedicated personal password / uid created for Avalon
LAMPAC_UID=avalon
# Optional alternatives (Lampac accepts any of these query params):
# LAMPAC_TOKEN=
# LAMPAC_ACCOUNT_EMAIL=
